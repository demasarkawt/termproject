# Copied to `.env` for local dev / production builds.
# Vite injects these at build time — rebuild after changing.

# Railway (or any) FastAPI base URL — no trailing slash
VITE_API_URL=https://termproject-production.up.railway.app

# Same value as ADMIN_KEY on the backend — required for POST/PATCH/DELETE admin routes
VITE_ADMIN_KEY=
