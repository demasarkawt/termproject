# Copy to `.env` — Vite reads these only when starting dev server or at build time.
#
# VITE_API_URL — REQUIRED for predictable behaviour.
# Use your Railway HTTPS URL with NO trailing slash, e.g.:
#   VITE_API_URL=https://your-service.up.railway.app
# Leaving VITE_API_URL blank used to break routing (requests went to this app's origin
# instead of the API). The dashboard client now falls back to production if empty —
# still set this explicitly when developing locally against localhost API:
#   VITE_API_URL=http://127.0.0.1:8000

VITE_API_URL=https://termproject-production.up.railway.app

# Same value as ADMIN_KEY on the backend — required for admin POST/PATCH/DELETE
VITE_ADMIN_KEY=
