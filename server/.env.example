# ─── Kurdistan Go Backend — Environment Variables ─────────────────────────────
# Copy this file to .env and fill in your values.
# Railway automatically injects DATABASE_URL — only needed for local development.

DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DATABASE_NAME

# ─── Admin ────────────────────────────────────────────────────────────────────
ADMIN_KEY=change-me

# ─── Cloudflare R2 (S3-compatible) ────────────────────────────────────────────
# Account ID is the subdomain of your R2 endpoint, e.g.
#   https://<ACCOUNT_ID>.r2.cloudflarestorage.com
R2_ACCOUNT_ID=YOUR_CLOUDFLARE_ACCOUNT_ID
R2_BUCKET_NAME=your-bucket-name
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Optional: public dev URL or custom domain that serves the bucket.
# If empty, the API will return presigned URLs instead.
# Examples:
#   https://pub-xxxxxxxxxxxxxxxx.r2.dev
#   https://media.example.com
R2_PUBLIC_URL=
# Lifetime (seconds) of generated presigned download URLs.
R2_PRESIGN_EXPIRES=3600

# ─── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of origins allowed to call the API. Leave blank during
# development to allow any origin. In production set this to your dashboard
# and (optionally) Flutter web origin.
# Example:
#   CORS_ORIGINS=https://admin.example.com,https://app.example.com
CORS_ORIGINS=
